[Unit]
Description=Neighborhood Rhythm collector (one-shot scanner)
After=network-online.target

[Service]
Type=oneshot
# Root so `iw dev wlan0 scan` works without sudoers; chown hands DB back to siropkin.
User=root
Group=siropkin
WorkingDirectory=/home/siropkin/neighborhood-rhythm
ExecStart=/home/siropkin/lightcontrol_venv/bin/python /home/siropkin/neighborhood-rhythm/collector.py
Environment=PYTHONUNBUFFERED=1
Environment=RHYTHM_SENSOR_ID=sivanpi
Environment=HOME=/home/siropkin
# Backstop: a hung bleak scan blocks the timer without this.
TimeoutStartSec=120

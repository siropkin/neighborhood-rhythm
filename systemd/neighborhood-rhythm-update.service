[Unit]
Description=Neighborhood Rhythm self-update (checks GitHub for a new release tag)
After=network-online.target

[Service]
Type=oneshot
# Runs as root so it can restart services + git reset in the app dir.
ExecStart=/home/siropkin/neighborhood-rhythm/scripts/rhythm-update.sh
Environment=RHYTHM_REPO=siropkin/neighborhood-rhythm
Environment=RHYTHM_APP_DIR=/home/siropkin/neighborhood-rhythm
Environment=RHYTHM_VENV=/home/siropkin/lightcontrol_venv/bin/python
Environment=RHYTHM_STATE_DIR=/var/lib/neighborhood-rhythm
Environment=HOME=/home/siropkin
